{
  "name": "react-google-ads-advanced",
  "version": "1.0.5",
  "description": "A React component for integrating Google Ads with capability to suppress ads which are unfilled or not loaded, enhancing user experience by avoiding empty ad spaces.",
  "keywords": [
    "react",
    "nextjs",
    "next.js",
    "adsense",
    "google adsense",
    "google ads",
    "ads",
    "react adsense",
    "next adsense",
    "advanced ads"
  ],
  "homepage": "https://faraasat.github.io/react-google-ads-advanced",
  "bugs": {
    "url": "https://github.com/faraasat/react-google-ads-advanced/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/react-google-ads-advanced.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/index.css",
    "./dist/*.css": "./dist/*.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && npm run test -- --run && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
